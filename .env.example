####################### FLASK ########################
FLASK_APP=src/web/main.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=your-secret-key-here       # Chave secreta para sessões
FLASK_HOST=0.0.0.0                          # Host do servidor
FLASK_PORT=5000                             # Porta do servidor

####################### DERIV ####################
TOKEN=seu-token-deriv                       # Token de autenticação Deriv
ACTIVE_TOKEN=seu-token-ativo                # Token ativo (opcional)
DERIV_WEBSOCKET_URL=wss://ws.binaryws.com/websockets/v3  # URL do WebSocket
DERIV_API_KEY=your-api-key-here             # API Key da Deriv
DERIV_APP_ID=1089                           # App ID da Deriv

####################### DEEPSEEK #####################
DEEPSEEK_API_KEY=sua-chave-api-deepseek     # Gere no site DeepSeek

####################### ADMIN ########################
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_TOKEN=seu-token-admin                  # Código de licença
ADMIN_TOKEN_DEMO=seu-token-demo             # Token demo do admin
ADMIN_TOKEN_REAL=seu-token-real             # Token real do admin
ADMIN_DERIV_DEMO=seu-login-demo             # Login demo
ADMIN_DERIV_REAL=seu-login-real             # Login real

####################### BANCO DE DADOS ##############
DATABASE_URL=sqlite:///data/derivbot.db

####################### EMAIL #######################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

####################### SEGURANÇA ###################
MAX_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT=3600
PASSWORD_MIN_LENGTH=8

####################### MODOS / VALORES ##############
MODO_REAL=False                             # True para modo real, False para demo
VALOR_ENTRADA=5                             # Valor de entrada em USD
TIMEFRAME=1                                 # Timeframe em segundos
MAX_OPERATIONS=50                           # Máximo de operações simultâneas
STOP_LOSS=30                                # Stop loss em porcentagem
TAKE_PROFIT=50                              # Take profit em porcentagem

####################### INDICADORES ##################
RSI_PERIODO=5                               # Período do RSI
RSI_SOBRECOMPRADO=70                        # Nível de sobrecompra
RSI_SOBREVENDIDO=30                         # Nível de sobrevenda
BOLLINGER_PERIODO=10                        # Período das Bollinger Bands
BOLLINGER_DESVIO=2                          # Desvio padrão das Bollinger Bands

####################### ATIVO #######################
ATIVO_PADRAO=R_100                          # Ativo padrão para operações

####################### LOG ##########################
LOG_LEVEL=INFO                              # Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_FILE=trading.log                        # Arquivo de log 