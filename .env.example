# ===== DERIVBOT CONFIGURAÇÕES DE AMBIENTE (TEMPLATE) =====
# Copie este arquivo para .env e preencha com suas configurações reais.

FLASK_ENV=production
DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
MODO_REAL=False
SECRET_KEY=sua_chave_secreta_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
ADMIN_API_KEY=sua_chave_api_admin_aqui
ADMIN_LICENSES=DERIVBOT-XXXX-XXXX

# Configurações SMTP (Opcional - para envio de e-mails via admin)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
